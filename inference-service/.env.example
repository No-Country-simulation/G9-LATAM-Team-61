# Configuración del Microservicio de Inferencia (FastAPI)
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# Configuración de Inferencia y Normalización
MIN_TEXT_LENGTH=30
MAX_TEXT_LENGTH=5000
KEYWORDS_TOP_N=8
MAX_BATCH_SIZE=100
MAX_CLUSTERING_DOCS=200

# Traducción Automática (none | google) - Desactivada por defecto
TRANSLATOR_BACKEND=none
TRANSLATE_TARGET_LANG=en
