# Configuración del Microservicio de Inferencia FastAPI
# Copiar como .env en producción/desarrollo

# Backend de traducción: google | none
TRANSLATOR_BACKEND=google

# Idioma destino de inferencia
TRANSLATE_TARGET_LANG=en

# Tamaño máximo permitido de texto (caracteres)
MAX_TEXT_LENGTH=10000

# Número de palabras clave a extraer
KEYWORDS_TOP_N=8
