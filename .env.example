# Baseline integrada local de TechMind.
# Copiar como .env y completar los valores requeridos antes de usar Compose.

# Único puerto publicado al host (solo interfaz local).
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_HTTP_PORT=8080

# Overlay HTTPS opcional (compose.https.yaml). Las rutas son del host OCI.
FRONTEND_HTTPS_PORT=443
LETSENCRYPT_PATH=/etc/letsencrypt
ACME_WEBROOT_PATH=/var/lib/techmind/acme

# PostgreSQL. La contraseña debe definirse en el .env local y nunca versionarse.
POSTGRES_DB=techmind
POSTGRES_USER=techmind_app
POSTGRES_PASSWORD=

# Spring Boot.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
FASTAPI_URL=http://inference:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:${FRONTEND_HTTP_PORT},http://localhost:${FRONTEND_HTTP_PORT}
# OCI durante la transición HTTP/HTTPS:
# CORS_ALLOWED_ORIGINS=http://techmind-kms.duckdns.org,https://techmind-kms.duckdns.org
# OCI después del smoke HTTPS:
# CORS_ALLOWED_ORIGINS=https://techmind-kms.duckdns.org

# Variables de build de React/Vite.
VITE_API_BASE_URL=/api
VITE_ENABLE_DEMO=false

# Inference service.
MIN_TEXT_LENGTH=30
MAX_TEXT_LENGTH=5000
KEYWORDS_TOP_N=8
MAX_BATCH_SIZE=100
MAX_CLUSTERING_DOCS=200
TRANSLATOR_BACKEND=none
TRANSLATE_TARGET_LANG=en
