# ============================================================
# PLANTILLA DE CONFIGURACIÓN LOCAL (.env.example)
# ============================================================
# Instrucciones de inicio rápido:
# 1. Copia este archivo como ".env" en la raíz del backend:
#    cp .env.example .env  (o duplicar manualmente en Windows)
# 2. Ajusta las credenciales si utilizas valores personalizados.
# 3. Levanta la base de datos PostgreSQL con Docker:
#    docker compose up -d
# ============================================================

# --- Base de datos PostgreSQL (Docker Compose) ---
POSTGRES_DB=hackaton_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Variables opcionales para Spring Boot ---
# SPRING_PROFILES_ACTIVE=local  (Perfil predeterminado: activa el mock en puerto 8080)
# FASTAPI_URL=http://localhost:8080 (Requerido solo si se ejecuta en perfil prod)