# Ejemplo de plantilla de variables de entorno para KMS Frontend
# Copiar como .env o .env.local para desarrollo local

# URL del servidor backend de Spring Boot
VITE_API_BASE_URL=http://localhost:8080/api

# Activar explícitamente modo demostrativo local (true/false)
# true: usa datos de inferencia simulados localmente en entorno de desarrollo sin requerir backend
# false: conecta exclusivamente al servidor Spring Boot en vivo (Lanza errores si backend/FastAPI fallan)
VITE_ENABLE_DEMO=false
