# Ejemplo de plantilla de variables de entorno para KMS Frontend
# Copiar como .env o .env.local para desarrollo local

# URL del servidor backend de Spring Boot
VITE_API_BASE_URL=http://localhost:8080/api

# Forzar modo demo local (true/false)
# true: usa datos de inferencia simulados localmente sin requerir backend
# false: conecta exclusivamente al servidor Spring Boot en vivo
VITE_USE_MOCK=false
